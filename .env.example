# Copy to .env and fill in. Never commit .env.
SITE_NAME=Property Video Studio
BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

# Admin page (/admin) login
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Payments: "fake" skips Stripe and marks orders paid at once (local work only)
PAYMENTS_MODE=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: "console" prints emails to the log
MAILER=console
RESEND_API_KEY=
EMAIL_FROM=videos@example.com

# Pipeline steps: "fake" runs without any AI. Real providers plug in later.
SHOT_PLANNER=fake
STAGER=fake
CLIP_GENERATOR=fake
ASSEMBLER=ffmpeg
FAL_KEY=
ANTHROPIC_API_KEY=

# Queue
DAILY_CAP=10
AVG_RENDER_MINUTES=30
REQUIRE_APPROVAL=true
